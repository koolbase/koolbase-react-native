{
  "name": "@koolbase/react-native",
  "version": "10.0.2",
  "description": "React Native SDK for Koolbase \u2014 auth, database, storage, realtime, feature flags, and functions in one package.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.js react-native"
  },
  "keywords": [
    "koolbase",
    "react-native",
    "baas",
    "firebase-alternative",
    "flutter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koolbase/koolbase-react-native"
  },
  "dependencies": {
    "@koolbase/core": "10.0.2"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/netinfo": "^12.0.1",
    "react-native": ">=0.70.0",
    "react-native-keychain": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-keychain": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
